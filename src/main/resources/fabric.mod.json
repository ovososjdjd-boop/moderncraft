{
  "schemaVersion": 1,
  "id": "moderncraft",
  "version": "${version}",
  "name": "Moderncraft",
  "description": "Living economy mod: phones, banks, jobs (courier, loader, factory worker), stock market, and a parcel pickup point replacing villager trading.",
  "authors": [
    "moderncraft team"
  ],
  "contact": {
    "homepage": "https://example.com"
  },
  "license": "MIT",
  "icon": "assets/moderncraft/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.moderncraft.Moderncraft"
    ],
    "client": [
      "com.moderncraft.client.ModerncraftClient"
    ]
  },
  "mixins": [
    "moderncraft.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  },
  "custom": {
    "modmenu": {
      "badges": [ "library" ]
    }
  }
}
